# BEGIN emergency glicko CGI fallback (do not use while Passenger works)
Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
DirectoryIndex disabled
RewriteEngine On
RewriteBase /glicko/
RewriteRule ^glicko\.cgi$ - [END]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^static/ - [END]
RewriteRule ^ glicko.cgi [END]
# END glicko CGI fallback
